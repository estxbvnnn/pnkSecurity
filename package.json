{
  "name": "carta-digital-node",
  "version": "1.0.0",
  "description": "Carta Digital - Node.js + Express + TypeScript + PostgreSQL (3ra/4ta entrega)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run build:server && npm run build:client && node scripts/copy-assets.js",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "lint:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "multer": "^2.5.0",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "sweetalert2": "^11.26.25",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
