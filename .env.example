# Copiar como .env y ajustar. NUNCA versionar el .env real.

NODE_ENV=development
PORT=3000

# --- Base de datos PostgreSQL ---
# Opción A (dev local): Postgres corriendo en tu PC o en Docker local (docker-compose).
# Opción B (dev contra el servidor real): abrir un túnel SSH y apuntar aquí a localhost:
#   ssh -i test.pem -L 5432:127.0.0.1:5432 ec2-user@52.0.165.26
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=carta_digital
PGUSER=carta_app
PGPASSWORD=CAMBIA_ESTA_CLAVE

# --- Sesión ---
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# true solo si la app se sirve por HTTPS
SESSION_SECURE_COOKIE=false
