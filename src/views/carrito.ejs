<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Carrito</title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<section>
  <div class="container contendor">
    <div class="row">
      <div class="col-lg-12 d-flex justify-content-between align-items-center">
        <img class="logosintituciones" src="/img/logo.png" width="170px" alt="">
        <div>
          <a class="btn btn-primary" href="/restaurante/<%= restauranteId %>">Volver a la Carta</a>
          <a class="btn btn-secondary" id="btnVaciar" href="#">Eliminar Todo</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container contendor">
    <h4 class="text-center">Productos Agregados para Solicitar</h4>
    <table class="table table-hover">
      <thead>
        <tr><th>Código</th><th>Producto</th><th>Restaurante</th><th>Precio</th><th>Acción</th></tr>
      </thead>
      <tbody>
        <% carrito.forEach(function(item) { %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.nombre %></td>
            <td><%= item.restauranteNombre %></td>
            <td>$ <%= Number(item.precio).toLocaleString('es-CL') %></td>
            <td><a href="#" class="btn-elim text-danger" data-pos="<%= item.posicion %>">🗑</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% var restaurantesDistintos = [...new Set(carrito.map(function(i) { return i.restauranteNombre; }))]; %>
    <% if (restaurantesDistintos.length > 1) { %>
      <p class="text-center text-muted">
        Tu carrito tiene productos de <%= restaurantesDistintos.length %> restaurantes distintos
        (<%= restaurantesDistintos.join(', ') %>) — se van a confirmar como pedidos separados, uno por restaurante.
      </p>
    <% } %>
    <h3 class="text-center">
      Total: $ <%= Number(carrito.reduce(function(s, i) { return s + Number(i.precio); }, 0)).toLocaleString('es-CL') %>
    </h3>
    <% if (carrito.length) { %>
      <form id="formConfirmarPedido" class="text-center" method="post" action="/carrito/confirmar">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-success btn-lg">✅ Confirmar Pedido</button>
      </form>
      <p class="text-center text-muted mt-2">o avísale directamente al garzón para solicitarlo.</p>
    <% } else { %>
      <h5 class="text-center text-muted">Tu carrito está vacío.</h5>
    <% } %>
  </div>
</section>

<script src="/vendors/jquery/jquery-3.2.1.min.js"></script>
<script src="/vendors/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/dist/carrito.js"></script>
</body>
</html>
