<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carta Digital — Restaurantes</title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
<section>
  <div class="container contendor my-4">
    <div class="text-center mb-4">
      <img class="logosintituciones" src="/img/logo.png" width="190px" alt="">
      <h3 class="mt-3">Elige un restaurante</h3>
    </div>
    <div class="row">
      <% restaurantes.forEach(function(r) { %>
        <div class="col-lg-4 col-md-6 mb-4">
          <a class="text-decoration-none" href="/restaurante/<%= r.id %>">
            <div class="featured-item h-100 text-center p-3">
              <img class="card-img rounded-0 mb-2" width="140" height="140" style="object-fit:contain"
                   src="<%= r.foto ? '/imagenes/cod' + r.id + '/' + r.foto : '/img/logo_empresa_comodin.png' %>" alt="">
              <h5><%= r.nombre %></h5>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
    <% if (!restaurantes.length) { %>
      <p class="text-center text-muted">No hay restaurantes disponibles todavía.</p>
    <% } %>
  </div>
</section>
</body>
</html>
