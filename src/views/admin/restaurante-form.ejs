<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= restaurante ? 'Editar' : 'Nuevo' %> restaurante</title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/vendors/themify-icons/themify-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="admin-body" data-form-error="<%= error || '' %>">

<nav class="admin-bar d-flex justify-content-between align-items-center">
  <div class="admin-brand">
    <i class="ti-<%= restaurante ? 'pencil' : 'plus' %>"></i> <%= restaurante ? 'Editar' : 'Nuevo' %> restaurante
  </div>
  <a class="btn btn-sm btn-outline-light" href="/admin/restaurantes"><i class="ti-arrow-left"></i> Volver</a>
</nav>

<div class="container contendor my-4" style="max-width:680px">
  <div class="admin-form-card">
    <% if (error) { %>
      <div class="alert alert-danger">Revisa los datos ingresados (nombre, RUT, teléfono y dirección son obligatorios).</div>
    <% } %>

    <form method="post" enctype="multipart/form-data"
          action="<%= restaurante ? '/admin/restaurantes/' + restaurante.id : '/admin/restaurantes' %>">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <% if (restaurante) { %>
        <div class="form-group mb-3">
          <label>Foto / logo</label>
          <% if (restaurante.foto) { %>
            <div class="mb-2">
              <img src="/imagenes/cod<%= restaurante.id %>/<%= restaurante.foto %>" alt="Foto actual"
                   style="max-width:140px;max-height:140px;border-radius:8px;border:1px solid var(--admin-border);display:block">
            </div>
          <% } %>
          <input type="file" class="form-control" name="foto" accept="image/jpeg,image/png,image/webp,image/gif">
          <small class="text-muted">Dejar vacío para mantener la foto actual.</small>
        </div>
      <% } %>

      <div class="form-group mb-3">
        <label>Nombre del restaurante</label>
        <input type="text" class="form-control" name="nombre" maxlength="200" required
               value="<%= restaurante ? restaurante.nombre : '' %>">
      </div>

      <div class="row mb-3">
        <div class="col">
          <label>RUT</label>
          <input type="text" class="form-control" name="rut" maxlength="11" required
                 placeholder="99887766-5" value="<%= restaurante ? restaurante.rut : '' %>">
        </div>
        <div class="col">
          <label>Teléfono</label>
          <input type="text" class="form-control" name="fono" maxlength="45" required
                 value="<%= restaurante ? restaurante.fono : '' %>">
        </div>
      </div>

      <div class="form-group mb-3">
        <label>Email de contacto</label>
        <input type="email" class="form-control" name="email" maxlength="100"
               value="<%= restaurante ? (restaurante.email || '') : '' %>">
      </div>

      <hr>
      <h6 class="text-muted mb-3">Dirección</h6>

      <div class="row mb-3">
        <div class="col-8">
          <label>Calle</label>
          <input type="text" class="form-control" name="calle" maxlength="100" required
                 value="<%= restaurante ? restaurante.calle : '' %>">
        </div>
        <div class="col-4">
          <label>Número</label>
          <input type="text" class="form-control" name="numero" maxlength="15" required
                 value="<%= restaurante ? restaurante.numero : '' %>">
        </div>
      </div>

      <div class="row mb-4">
        <div class="col">
          <label>Comuna</label>
          <input type="text" class="form-control" name="comuna" maxlength="100" required
                 value="<%= restaurante ? restaurante.comuna : '' %>">
        </div>
        <div class="col">
          <label>Región</label>
          <input type="text" class="form-control" name="region" maxlength="100"
                 value="<%= restaurante ? (restaurante.region || '') : '' %>">
        </div>
      </div>

      <button type="submit" class="btn btn-admin-primary">
        <i class="ti-check"></i> <%= restaurante ? 'Guardar cambios' : 'Crear restaurante' %>
      </button>
      <a class="btn btn-outline-secondary" href="/admin/restaurantes">Cancelar</a>
    </form>
  </div>
</div>

</body>
</html>
