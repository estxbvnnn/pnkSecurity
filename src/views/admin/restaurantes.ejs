<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurantes — Administración</title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/vendors/themify-icons/themify-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="admin-body">

<nav class="admin-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div class="admin-brand"><i class="ti-location-pin"></i> Restaurantes</div>
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <a class="btn btn-sm btn-outline-light" href="/admin"><i class="ti-arrow-left"></i> Volver al panel</a>
  </div>
</nav>

<div class="container contendor my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Todos los restaurantes</h5>
    <a class="btn btn-admin-primary" href="/admin/restaurantes/nuevo">
      <i class="ti-plus"></i> Nuevo restaurante
    </a>
  </div>

  <div class="admin-section">
    <table class="admin-tabla-items">
      <thead>
        <tr>
          <th>Restaurante</th>
          <th>RUT</th>
          <th>Teléfono</th>
          <th>Dirección</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% restaurantes.forEach(function(r) { %>
          <tr>
            <td><div class="producto-nombre"><%= r.nombre %></div></td>
            <td><%= r.rut %></td>
            <td><%= r.fono %></td>
            <td><%= r.calle %> #<%= r.numero %>, <%= r.comuna %></td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-primary" href="/admin/restaurantes/<%= r.id %>/editar" title="Editar">
                <i class="ti-pencil"></i>
              </a>
              <a class="btn btn-sm btn-outline-secondary" href="/restaurante/<%= r.id %>" title="Ver carta pública">
                <i class="ti-eye"></i>
              </a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

</body>
</html>
