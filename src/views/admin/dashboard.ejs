<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Administrar Carta — <%= restaurante ? restaurante.nombre : '' %></title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/vendors/themify-icons/themify-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="admin-body" data-ok="<%= mensaje || '' %>">

<nav class="admin-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div class="admin-brand">
    <i class="ti-dashboard"></i> Panel de Administración
  </div>

  <div class="d-flex align-items-center gap-2 flex-wrap">
    <form method="get" action="/admin" class="d-flex align-items-center gap-2">
      <select name="id" class="form-control form-control-sm form-select-sm selector-restaurante">
        <% restaurantes.forEach(function(r) { %>
          <option value="<%= r.id %>" <%= r.id === restauranteId ? 'selected' : '' %>><%= r.nombre %></option>
        <% }); %>
      </select>
    </form>
    <a class="btn btn-sm btn-outline-light" href="/restaurante/<%= restauranteId %>">
      <i class="ti-eye"></i> Ver Carta Pública
    </a>
    <a class="btn btn-sm btn-outline-light" href="/admin/restaurantes">
      <i class="ti-location-pin"></i> Restaurantes
    </a>
    <a class="btn btn-sm btn-outline-light" href="/admin/ventas?id=<%= restauranteId %>">
      <i class="ti-bar-chart"></i> Ventas
    </a>
    <a class="btn btn-sm btn-outline-light" href="/admin/seguridad">
      <i class="ti-shield"></i> Seguridad
    </a>
    <a class="btn btn-sm btn-outline-light" href="/admin/owasp">
      <i class="ti-clipboard"></i> OWASP
    </a>
    <a class="btn btn-sm btn-outline-light" href="/logout">
      <i class="ti-power-off"></i> Cerrar Sesión
    </a>
  </div>
</nav>

<div class="container contendor my-4">

  <div class="admin-stats">
    <div class="admin-stat-card">
      <div class="icono"><i class="ti-layout-menu"></i></div>
      <div><div class="valor"><%= stats.cartas %></div><div class="etiqueta">Cartas</div></div>
    </div>
    <div class="admin-stat-card">
      <div class="icono"><i class="ti-folder"></i></div>
      <div><div class="valor"><%= stats.categorias %></div><div class="etiqueta">Categorías</div></div>
    </div>
    <div class="admin-stat-card">
      <div class="icono"><i class="ti-bag"></i></div>
      <div><div class="valor"><%= stats.productos %></div><div class="etiqueta">Productos</div></div>
    </div>
    <div class="admin-stat-card destacados">
      <div class="icono"><i class="ti-star"></i></div>
      <div><div class="valor"><%= stats.destacados %></div><div class="etiqueta">Destacados</div></div>
    </div>
    <div class="admin-stat-card ocultos">
      <div class="icono"><i class="ti-na"></i></div>
      <div><div class="valor"><%= stats.ocultos %></div><div class="etiqueta">Ocultos</div></div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><%= restaurante ? restaurante.nombre : '' %></h5>
    <a class="btn btn-admin-primary" href="/admin/items/nuevo">
      <i class="ti-plus"></i> Nuevo Producto
    </a>
  </div>

  <% cartasConCategorias.forEach(function(seccion, idx) { %>
    <div class="admin-section">
      <div class="admin-section-header" data-toggle="collapse" data-target="#carta-<%= seccion.carta.id %>"
           aria-expanded="true" role="button">
        <span class="titulo">
          <i class="ti-layout-menu"></i>
          <%= seccion.carta.nombre %>
          <% if (!seccion.carta.visible) { %><span class="badge-oculto ms-1">OCULTA</span><% } %>
        </span>
        <span class="d-flex align-items-center gap-2">
          <form class="form-toggle-carta" method="post" action="/admin/cartas/<%= seccion.carta.id %>/toggle">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
              <%= seccion.carta.visible ? 'Ocultar' : 'Mostrar' %>
            </button>
          </form>
          <i class="ti-angle-down chevron"></i>
        </span>
      </div>

      <div class="collapse show admin-section-body" id="carta-<%= seccion.carta.id %>">
        <% if (!seccion.categoriasConItems.length) { %>
          <div class="p-3 text-muted">Sin categorías todavía.</div>
        <% } %>

        <% seccion.categoriasConItems.forEach(function(ci) { %>
          <div class="admin-categoria-header">
            <span><i class="ti-folder"></i> <%= ci.categoria.nombre %>
              <% if (!ci.categoria.visible) { %><span class="badge-oculto ms-1">OCULTA</span><% } %>
            </span>
            <form method="post" action="/admin/categorias/<%= ci.categoria.id %>/toggle">
              <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
              <input type="hidden" name="cartaId" value="<%= seccion.carta.id %>">
              <button type="submit" class="btn btn-sm btn-outline-secondary">
                <%= ci.categoria.visible ? 'Ocultar' : 'Mostrar' %>
              </button>
            </form>
          </div>

          <% if (!ci.items.length) { %>
            <div class="px-4 py-2 text-muted small">Sin productos en esta categoría.</div>
          <% } else { %>
            <table class="admin-tabla-items">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Precio</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% ci.items.forEach(function(item) { %>
                  <tr>
                    <td>
                      <div class="producto-nombre"><%= item.nombre %></div>
                      <% if (item.descripcion) { %><div class="producto-desc"><%= item.descripcion %></div><% } %>
                    </td>
                    <td class="admin-precio">$ <%= Number(item.precio).toLocaleString('es-CL') %></td>
                    <td>
                      <% if (item.destacado) { %><span class="badge-destacado me-1"><i class="ti-star"></i> Destacado</span><% } %>
                      <% if (item.visible) { %><span class="badge-visible">Visible</span><% } else { %><span class="badge-oculto">Oculto</span><% } %>
                    </td>
                    <td class="text-end">
                      <a class="btn btn-sm btn-outline-primary" href="/admin/items/<%= item.id %>/editar" title="Editar">
                        <i class="ti-pencil"></i>
                      </a>
                      <form class="form-eliminar-item d-inline" method="post" action="/admin/items/<%= item.id %>/eliminar" data-nombre="<%= item.nombre %>">
                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                          <i class="ti-trash"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        <% }); %>

        <form class="admin-add-form d-flex gap-2 align-items-center" method="post" action="/admin/categorias">
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
          <input type="hidden" name="cartaId" value="<%= seccion.carta.id %>">
          <input type="text" class="form-control form-control-sm" name="nombre" placeholder="Nueva categoría" required maxlength="100" style="max-width:220px">
          <input type="number" class="form-control form-control-sm" name="orden" placeholder="Orden" style="max-width:90px">
          <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="ti-plus"></i> Agregar categoría</button>
        </form>
      </div>
    </div>
  <% }); %>

  <div class="admin-section">
    <div class="admin-section-header" style="cursor:default">
      <span class="titulo"><i class="ti-plus"></i> Nueva carta <span class="text-muted small">(sección del menú, ej. "Postres")</span></span>
    </div>
    <form class="admin-add-form d-flex gap-2 align-items-center" method="post" action="/admin/cartas">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <input type="text" class="form-control form-control-sm" name="nombre" placeholder="Nombre de la carta" required maxlength="45" style="max-width:220px">
      <input type="number" class="form-control form-control-sm" name="orden" placeholder="Orden" style="max-width:90px">
      <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="ti-plus"></i> Agregar carta</button>
    </form>
  </div>

</div>

<script src="/vendors/jquery/jquery-3.2.1.min.js"></script>
<script src="/vendors/bootstrap/bootstrap.bundle.min.js"></script>
<script src="/vendors/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/dist/admin.js"></script>
</body>
</html>
