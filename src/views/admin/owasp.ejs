<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mapeo OWASP Top 10 — Administración</title>
  <link rel="stylesheet" href="/vendors/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/vendors/themify-icons/themify-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    .owasp-codigo { display:inline-flex; align-items:center; justify-content:center; min-width:84px;
      font-weight:700; color:#fff; background:var(--admin-navy); border-radius:6px; padding:3px 10px;
      font-size:0.82rem; margin-right:10px; letter-spacing:0.02em; }
    .owasp-titulo-texto { font-weight:600; }
    .owasp-puntos { margin:0; padding-left:1.2rem; }
    .owasp-puntos li { margin-bottom:8px; line-height:1.45; }
    .owasp-puntos li::marker { color: var(--admin-accent); }
    .owasp-riesgo { margin-top:12px; padding:10px 14px; background:#fff8e1; border-left:4px solid var(--admin-accent);
      border-radius:4px; font-size:0.9rem; display:flex; gap:8px; align-items:flex-start; }
    .owasp-riesgo i { color:#b8860b; margin-top:2px; }
    .owasp-puntos code, .owasp-riesgo code { background:#eef1f4; padding:1px 5px; border-radius:4px; font-size:0.87em; }
    .owasp-badge-ok { display:inline-flex; align-items:center; gap:4px; font-size:0.72rem; font-weight:600;
      color:#2e7d32; background:#e8f5e9; border-radius:999px; padding:2px 10px; margin-left:auto; }
    .owasp-badge-pendiente { display:inline-flex; align-items:center; gap:4px; font-size:0.72rem; font-weight:600;
      color:#9a6b00; background:#fff3cd; border-radius:999px; padding:2px 10px; margin-left:auto; }
    .owasp-icono { font-size:1.1rem; width:26px; text-align:center; color:var(--admin-navy); }
    .owasp-brechas { background:#eef7ee; border:1px solid #cfe8cf; border-radius:8px; }
    .owasp-brechas .owasp-puntos li::marker { color:#2e7d32; }
    .owasp-intro { background:#fff; border:1px solid var(--admin-border); border-radius:8px; padding:14px 18px; }
  </style>
</head>
<body class="admin-body">

<nav class="admin-bar d-flex justify-content-between align-items-center">
  <div class="admin-brand"><i class="ti-shield"></i> Mapeo OWASP Top 10 (2021)</div>
  <a class="btn btn-sm btn-outline-light" href="/admin"><i class="ti-arrow-left"></i> Volver al panel</a>
</nav>

<div class="container contendor my-4" style="max-width:900px">

  <div class="admin-stats mb-3">
    <div class="admin-stat-card">
      <div class="icono"><i class="ti-layout-grid4"></i></div>
      <div><div class="valor"><%= stats.categorias %></div><div class="etiqueta">Categorías OWASP</div></div>
    </div>
    <div class="admin-stat-card">
      <div class="icono"><i class="ti-check-box"></i></div>
      <div><div class="valor"><%= stats.controles %></div><div class="etiqueta">Controles implementados</div></div>
    </div>
    <div class="admin-stat-card ocultos">
      <div class="icono"><i class="ti-alert"></i></div>
      <div><div class="valor"><%= stats.pendientes %></div><div class="etiqueta">Con riesgo aceptado</div></div>
    </div>
    <div class="admin-stat-card destacados">
      <div class="icono"><i class="ti-star"></i></div>
      <div><div class="valor"><%= stats.brechas %></div><div class="etiqueta">Brechas cerradas</div></div>
    </div>
  </div>

  <p class="owasp-intro text-muted mb-4">
    Por cada categoría del OWASP Top 10 se indica qué control existe en el código y dónde está.
    Haz clic en una categoría para ver el detalle. Informe completo con evidencia archivo:línea en
    <code>docs/OWASP.md</code> del repositorio.
  </p>

  <% secciones.forEach(function(s) { %>
    <div class="admin-section mb-2">
      <div class="admin-section-header" data-toggle="collapse" data-target="#owasp-<%= s.indice %>"
           aria-expanded="false" role="button">
        <span class="titulo d-flex align-items-center" style="gap:2px">
          <span class="owasp-codigo"><%= s.codigo %></span>
          <i class="ti owasp-icono <%= s.icono %>"></i>
          <span class="owasp-titulo-texto"><%= s.titulo %></span>
        </span>
        <span class="d-flex align-items-center">
          <% if (s.riesgoAceptadoHtml) { %>
            <span class="owasp-badge-pendiente"><i class="ti-alert"></i> Riesgo pendiente</span>
          <% } else { %>
            <span class="owasp-badge-ok"><i class="ti-check"></i> Cubierto</span>
          <% } %>
          <i class="ti-angle-down chevron ms-2"></i>
        </span>
      </div>
      <div class="collapse admin-section-body" id="owasp-<%= s.indice %>">
        <div class="p-3">
          <ul class="owasp-puntos">
            <% s.puntosHtml.forEach(function(p) { %>
              <li><%- p %></li>
            <% }); %>
          </ul>
          <% if (s.riesgoAceptadoHtml) { %>
            <div class="owasp-riesgo">
              <i class="ti-info-alt"></i>
              <div><strong>Riesgo aceptado / pendiente:</strong> <%- s.riesgoAceptadoHtml %></div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>

  <div class="admin-section owasp-brechas mt-4">
    <div class="admin-section-header" style="cursor:default; background:transparent; color:#1b4d1b">
      <span class="titulo"><i class="ti-star"></i> Brechas cerradas en esta fase (antes no existían)</span>
    </div>
    <div class="p-3">
      <ol class="owasp-puntos">
        <% brechasCerradas.forEach(function(b) { %>
          <li><%- b %></li>
        <% }); %>
      </ol>
    </div>
  </div>
</div>

<script src="/vendors/jquery/jquery-3.2.1.min.js"></script>
<script src="/vendors/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
