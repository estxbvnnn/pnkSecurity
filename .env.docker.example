# Plantilla para cada ambiente de Docker. Copiar como .env.dev / .env.qa / .env.prod
# (nunca versionar esos 3 archivos — ver .gitignore) y poner una clave y un
# secreto de sesión DISTINTOS en cada uno, para que los 3 ambientes queden
# totalmente aislados entre sí.
#
#   cp .env.docker.example .env.dev
#   cp .env.docker.example .env.qa
#   cp .env.docker.example .env.prod

# --- Postgres (leído por la imagen oficial postgres:17-alpine) ---
POSTGRES_DB=carta_digital
POSTGRES_USER=carta_app
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

# --- Mismos valores, pero con los nombres que lee la app (pg los usa por convención) ---
PGDATABASE=carta_digital
PGUSER=carta_app
PGPASSWORD=CAMBIA_ESTA_CLAVE

# --- Sesión ---
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# true solo si ese ambiente se sirve por HTTPS (ej. detrás de Cloudflare/producción)
SESSION_SECURE_COOKIE=false
