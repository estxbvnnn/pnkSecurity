{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "moduleResolution": "node",
    "lib": ["ES2017", "DOM"],
    "outDir": "src/public/js/dist",
    "rootDir": "src/public/js/src",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false
  },
  "include": ["src/public/js/src/**/*.ts"]
}
